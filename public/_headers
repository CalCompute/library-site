# Search index chunks have content-hashed names, so they never change once deployed.
# pagefind.js, pagefind-entry.json and the wasm files keep their names and stay revalidated.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable

# The hero counts, read live by CaliforniaCompute.org's Framework section.
/stats.json
  Access-Control-Allow-Origin: *
