---
// The page for any address with nothing at it. Cloudflare serves the built 404.html.
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <article class="article-prose max-w-3xl">
    <h1>Page not found</h1>
    <p>Nothing is at this address. It may have moved when its page was renamed.</p>
    <p><a class="btn btn-primary" href="/search/">Search the library</a> <a class="btn" href="/">Go to the home page</a></p>
  </article>
</Layout>
