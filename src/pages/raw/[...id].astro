---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import Folder from '../../components/Folder.astro';
import { load } from '../../lib/load.js';
import { dirs, idOf, driveHref, routeOf, rendersHere } from '../../lib/wiki.js';

export async function getStaticPaths() {
  const m = await load();
  const pages = m.pages.filter((p) => p.tree === 'raw' && p.route).map((p) => ({ params: { id: p.route.slice('/raw/'.length, -1) }, props: { rel: p.rel } }));
  const folders = [...dirs].filter((d) => d.split('/')[0] === 'raw').map((d) => ({ params: { id: d === 'raw' ? undefined : idOf(d) }, props: { dir: d } }));
  return [...pages, ...folders];
}
const m = await load();
const { rel, dir } = Astro.props;
const page = rel && m.byRel.get(rel);
---
<Layout title={page ? page.title : dir + '/'} redirect={page && rendersHere(page.route) ? null : driveHref(page ? page.route : routeOf(dir))}>
  {page ? <Page page={page} m={m} /> : <Folder dir={dir} m={m} />}
</Layout>
