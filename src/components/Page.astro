---
// One wiki or raw page: hero (type, title, frontmatter, local graph), rails, the rendered
// markdown, and a footer naming the source file. Element reading lists end with a Suggest reading button.
import { render } from 'astro:content';
import GraphView, { COLORS } from './WikiGraph.jsx';
import WikiNav from './WikiNav.astro';
import WikiToc from './WikiToc.astro';
import Icon from './Icon.astro';
import Shelf from './Shelf.astro';
import { localGraph, linkList, evidenceOf } from '../lib/load.js';
import { files, day, routeOf, RAW_FOLDERS, pageDate, plain, driveHref, rehosted, profileLinks } from '../lib/wiki.js';
import { photoFor, logosFor } from '../lib/brand.js';
import { provenance } from '../lib/provenance.js';

const { page, m } = Astro.props;
const { Content, headings } = await render(page.entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const outlinks = linkList(m, m.linksOut.get(page.rel));
const backlinks = linkList(m, m.linksIn.get(page.rel));
const local = page.data && !page.readme && page.rel !== 'wiki/index.md' && page.rel !== 'wiki/log.md' ? localGraph(m, page.rel) : { nodes: [] };
const hideH1 = headings[0]?.depth === 1 && headings[0].text.trim() === page.title.trim();
const folder = page.rel.split('/').slice(0, -1).join('/');
const element = page.rel.startsWith('wiki/elements/') && page.data.element;
const member = page.tree === 'wiki' && page.data.type === 'entity' && m.teamNames.has(page.title) ? page.title : null;
// A team page is a profile: photo, position, institution and its mark, the californiacompute.org group and role,
// and its Links as a row, in place of the raw frontmatter list.
const GROUPS = { consortium: 'Consortium member', supporting: 'Supporting researcher', operations: 'Operations team', advocates: 'Government advocate', legislative: 'Legislative champion' };
const photo = member && (page.data.photo || photoFor(member));
// A PDF source's first page (scripts/covers.mjs), beside the title; it opens the original.
const cover = m.covers.get(page.rel);
const position = member ? String(page.data.position ?? '') : '';
const institution = member ? String(page.data.institution ?? '') : '';
const mark = member && logosFor(institution)[0];
const links = member ? profileLinks(page.body) : [];
const iconFor = (href) => (/linkedin\.com/.test(href) ? 'linkedin' : /github\.com/.test(href) ? 'github' : 'globe');

const sub = page.rel.split('/')[1];
const base = page.rel.replace(/\.md$/, '');
const originals = [...files].filter((f) => f !== page.rel && f.startsWith(base + '.') && !f.endsWith('.md') && rehosted(f));
const onlineUrl = page.data.url || page.data.fetched_url || page.data.sourceUrl;
const facts = Object.entries(page.data || {}).filter(([k]) => k !== 'title');

// Search (Pagefind reads these at build time; see /search/). One element per filter value: a joined
// value would be one filter "A, B". Meta and sort values are inline, so each needs its own element.
const list = (v) => (Array.isArray(v) ? v : String(v ?? '').split(',')).map((x) => String(x).trim()).filter(Boolean);
const tags = list(page.data.tags);
const letters = [...new Set([...list(page.data.elements), ...list(page.data.element), ...tags].filter((t) => /^[A-G]$/.test(t)))].sort();
const isDrive = /drive\.google|docs\.google/.test(onlineUrl || '');
const formats = [...new Set([...originals.map((o) => o.split('.').pop().toLowerCase()), ...(onlineUrl ? [isDrive ? 'drive' : 'online'] : [])])];
const node = m.graph.nodes.find((n) => n.id === page.route);
const firstPara = page.body.split(/\n\s*\n/).map((b) => b.trim()).find((b) => b && !/^(#|\||>|<|---|_Markdown copy|```|- |\* |\d+\. )/.test(b)) ?? '';
const summary = plain(m.sourceInfo.get(page.rel)?.summary || firstPara).replace(/\s+/g, ' ').slice(0, 220);
const date = pageDate(page.data, page.rel);
const rawRel = page.data.type === 'source' ? evidenceOf(m, page.rel) : null;
const { text: _, ...prov } = provenance(page, rawRel ? m.byRel.get(rawRel) : null, m.sourceInfo.get(page.rel));
const provText = Object.entries(prov).filter(([k]) => !['url', 'tier'].includes(k)).map(([, v]) => v).join(' · ');
// The facts' values (people, publisher, channel...) as plain words for the index; the <dl> itself is
// left out so excerpts don't read "urlhttps://...". Links, dates and the keys that are facets are skipped.
// Provenance keys are indexed through provText; ids are not words.
const factText = facts.filter(([k]) => !['type', 'tags', 'elements', 'element', 'origin', 'source_count', 'slug', 'excerpt_of', 'excerpt_lines', 'people', 'publisher'].includes(k)).flatMap(([, v]) => (Array.isArray(v) ? v : [v])).map((v) => (v instanceof Date ? '' : String(v)))
  .filter((v) => v && !/^(https?:|\d{4}-\d\d-\d\d|\d+$|true$|false$|unknown$|yes$|no$)/i.test(v)).join(' · ');
const filters = [
  `section:${page.tree}`,
  ...(page.data.origin ? [`origin:${page.data.origin}`] : []),
  ...letters.map((L) => `element:${L}`),
  ...tags.filter((t) => !/^[A-G]$/.test(t)).map((t) => `tag:${t}`),
  ...(formats.length ? formats : ['markdown']).map((f) => `format:${f}`),
];
const meta = Object.entries({
  path: page.rel, date, summary, elements: letters.join(' '), system: node?.system, thumb: node?.img ?? cover?.src,
  color: node?.hub ? COLORS.readme : COLORS[page.type] ?? COLORS.readme, linksin: String(backlinks.length),
  original: originals[0] && routeOf(originals[0]),
  drive: driveHref(page.route),
  prov: Object.keys(prov).length ? JSON.stringify(prov) : '',
}).filter(([, v]) => v);
---
<section class="pt-4 pb-6">
  <div class={local.nodes.length > 1 ? 'grid md:grid-cols-2 gap-8 items-start' : ''}>
    <div data-pagefind-body>
      <a href={routeOf(folder) ?? '/'} class="text-sm text-uc-blue-dark hover:underline" data-pagefind-ignore>← {folder}</a>
      <div class="mt-4 text-xs uppercase tracking-wide text-gray-500" data-pagefind-ignore data-pagefind-filter="kind" data-pagefind-meta="kind">{page.tree === 'raw' ? (page.readme ? 'folder guide' : RAW_FOLDERS[sub]?.[0] ?? sub) : page.type}</div>
      <div class="flex items-center gap-5 mt-1 mb-4">
        {photo && <img src={photo} alt="" width="128" height="128" class="h-32 w-32 shrink-0 rounded-full object-cover border border-gray-200" />}
        {cover && (
          <a href={cover.href ?? undefined} target="_blank" rel="noopener" title={cover.href ? 'Open the original' : undefined} class="shrink-0" data-pagefind-ignore>
            <img src={cover.src} alt="First page of the original document" width="320" height="414" class="h-40 w-auto rounded-sm border border-gray-200 shadow-md" />
          </a>
        )}
        <div class="min-w-0">
          <h1 class="text-3xl font-bold text-gray-900" data-pagefind-meta="title">{page.title}</h1>
          {member && (
            <div class="mt-2 space-y-1 text-sm text-gray-600" data-pagefind-ignore>
              {position && <p class="text-base text-gray-800">{position}</p>}
              {(mark || (institution && !position.includes(institution))) && (
                <p class="flex items-center gap-2">
                  {mark && <img src={mark.src} alt={mark.name} class="h-6 w-auto" />}
                  {institution && !position.includes(institution) && <span>{institution}</span>}
                </p>
              )}
              {GROUPS[page.data.group] && <p class="text-xs uppercase tracking-wide text-uc-blue-dark">{GROUPS[page.data.group]}</p>}
            </div>
          )}
        </div>
      </div>
      {member && page.data.role && <p class="mb-3 max-w-prose text-gray-700" data-pagefind-ignore>{page.data.role}</p>}
      {links.length > 0 && (
        <ul class="mb-4 flex flex-wrap gap-2" data-pagefind-ignore>
          {links.map((l) => (
            <li><a class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1 text-sm text-uc-blue-dark hover:border-uc-blue" href={l.href} target="_blank" rel="noopener"><Icon name={iconFor(l.href)} class="h-3.5 w-3.5" />{l.label} ↗</a></li>
          ))}
        </ul>
      )}
      {(originals.length > 0 || onlineUrl) && (
        <p class="text-sm mb-3 flex flex-wrap gap-x-4" data-pagefind-ignore>
          {originals.map((o) => routeOf(o) && <a class="underline text-uc-blue-dark" href={routeOf(o)} target="_blank" rel="noopener">{/drive\.google\.com/.test(routeOf(o)) ? 'Original in the Drive ↗' : 'Original ↗'}</a>)}
          {onlineUrl && <a class="underline text-uc-blue-dark" href={onlineUrl} target="_blank" rel="noopener">{/drive\.google|docs\.google/.test(onlineUrl) ? 'Open in the Drive ↗' : 'Online ↗'}</a>}
        </p>
      )}
      {facts.length > 0 && !member && (
        <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm text-gray-600 mb-2" data-pagefind-ignore>
          {facts.map(([k, v]) => (<><dt class="text-gray-400">{k}</dt><dd class="break-words">{v instanceof Date ? day(v) : Array.isArray(v) ? v.join(', ') : String(v)}</dd></>))}
        </dl>
      )}
      <p class="text-sm text-gray-500" data-pagefind-ignore>Links to {outlinks.length} · Referenced by {backlinks.length}</p>
      <div hidden>
        <p>{factText}</p>
        <p>{provText}</p>
        {filters.map((f) => <span data-pagefind-filter={f} />)}
        {meta.map(([k, v]) => <span data-pagefind-meta={`${k}:${v}`} />)}
        {date && <span data-pagefind-sort={`date:${date}`} />}
        <span data-pagefind-sort={`title:${page.title.toLowerCase()}`} />
      </div>
    </div>
    {local.nodes.length > 1 && (
      <div class="card p-2">
        <GraphView data={local} variant="classic" focusNodeId={page.route} labels height={360} filters={false} catalog={false} legend={false} client:visible />
        {member && <p class="px-2 pb-1 text-right text-sm" data-pagefind-ignore><a class="underline text-uc-blue-dark" href={`/graph/#${page.route}`}>Open in the full graph</a></p>}
      </div>
    )}
  </div>
</section>

{element === 'C' && (
  <aside class="card p-5 mb-8 flex flex-col sm:flex-row sm:items-center gap-4" data-pagefind-ignore>
    <div class="flex-1">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Interactive</p>
      <h2 class="text-lg font-bold text-uc-navy">Compute Governance Explorer</h2>
      <p class="text-sm text-gray-600 mt-1">Who owns, hosts, runs, funds, governs and allocates shared AI and HPC compute, compared across real configurations, with every fact tagged and sourced.</p>
    </div>
    <a class="btn btn-primary shrink-0" href="/explorer/">Open the explorer</a>
  </aside>
)}
{element && <Shelf shelf={m.shelves.find((s) => s.L === element)} heading="Shelf" />}

<section class="border-t border-gray-200 pt-8 lg:flex lg:gap-10">
  {(toc.length > 1 || outlinks.length || backlinks.length) && (
    <aside class="hidden lg:block w-56 shrink-0">
      <div class="sticky top-22 max-h-[calc(100vh-6.5rem)] overflow-y-auto pb-8">
        <WikiNav outlinks={outlinks} backlinks={backlinks} toc={toc} tocClass="xl:hidden" />
      </div>
    </aside>
  )}
  <div class="min-w-0 flex-1" data-pagefind-body data-pagefind-filter={`section:${page.tree}`}>
    <article class={`article-prose max-w-3xl ${hideH1 ? '[&>h1:first-child]:hidden' : ''}`}><Content /></article>
    {element && <p class="mt-6" data-pagefind-ignore><a class="btn" href="#suggest" data-element={element}>Suggest reading for element {element}</a></p>}
    <p class="mt-10 text-xs text-gray-500" data-pagefind-ignore>Source file: <code>{page.rel}</code>{page.data.updated && <>, updated {day(page.data.updated)}</>}.</p>
  </div>
  <WikiToc toc={toc} />
</section>

<script is:inline>
  // Search results link here with ?highlight=word; mark those words. Loads nothing otherwise.
  if (/[?&]highlight=/.test(location.search)) {
    const s = document.createElement('script');
    s.type = 'module'; s.src = '/pagefind/pagefind-highlight.js';
    s.onload = () => new PagefindHighlight({ highlightParam: 'highlight' });
    document.head.append(s);
  }
</script>
