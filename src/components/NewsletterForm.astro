---
// The newsletter sign-up: one email address, stored for later (src/worker.js). Nothing is sent yet.
// In the footer of every page and under the homepage hero; the explorer's footer carries a copy (index.html).
// id names the email field, so two forms on one page need two. dark is the footer's: it takes no classes of its own
// and is styled by .fb in global.css, as CaliforniaCompute.org's footer form.
const { dark = false, id = 'newsletter-email' } = Astro.props;
---
<form class="newsletter" data-newsletter novalidate>
  <label class={dark ? null : 'block text-sm font-medium'} for={id}>Follow the Research</label>
  <div class={dark ? 'newsletter-row' : 'mt-2 flex gap-2'}>
    <input id={id} name="email" type="email" required autocomplete="email" maxlength="254" placeholder="you@example.edu"
      class={dark ? null : 'min-w-0 flex-1 rounded-md px-2.5 py-1.5 text-sm border border-gray-300'} />
    <button type="submit" class={dark ? null : 'btn btn-primary py-1 text-sm'}>Subscribe</button>
  </div>
  <label class="hidden" aria-hidden="true">Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
  <input type="hidden" name="page" />
  <div data-turnstile></div>
  <p data-status aria-live="polite" class={dark ? null : 'mt-1 text-xs text-gray-600'}></p>
</form>

<script>
  import { check, send } from '../lib/forms.js';
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-newsletter]')) {
    const email = form.elements.namedItem('email') as HTMLInputElement;
    email.addEventListener('focus', () => check(form).catch(() => {}), { once: true });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (await send(form, 'subscribe', "Thank you. You're on the list.")) email.value = '';
    });
  }
</script>
