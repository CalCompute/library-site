---
// The Framework Report bar: how far it is from SB-53's signing (Sept. 29, 2025) to the report's due date (Jan. 1, 2027).
// No label, no dates, no percent; a shimmer runs along the fill as on the graph's Report (the user's calls, Nov. 6, 2026).
// CaliforniaCompute.org shows the same bar, labelled. Built at the build date; the script moves it to today. The fill
// grows from empty when the bar comes into view, held by the script until then (without JS it fills on load).
const START = Date.parse('2025-09-29'), END = Date.parse('2027-01-01');
const pct = Math.min(100, Math.max(0, Math.floor((100 * (Date.now() - START)) / (END - START))));
---
<div class="max-w-sm" data-report-progress data-start={START} data-end={END}>
  <div class="h-2 rounded-full bg-uc-blue-light overflow-hidden" role="progressbar" aria-label="Framework Report" aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct}>
    <div class="shimmer relative h-full rounded-full bg-uc-blue overflow-hidden" style={`width: ${pct}%`} data-fill></div>
  </div>
</div>
<style>
  [data-fill] {
    animation: report-progress-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .wait [data-fill] {
    animation-play-state: paused;
  }
  @keyframes report-progress-in {
    from { width: 0; }
  }
  /* A light band sweeping the fill every 1.6 s, the period of the Report's shimmer in WikiGraph.jsx. */
  .shimmer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.55), transparent);
    transform: translateX(-100%);
    animation: shimmer 1.6s ease-in-out infinite;
  }
  @keyframes shimmer {
    to { transform: translateX(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .shimmer::after { display: none; }
    [data-fill] { animation: none; }
  }
</style>
<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.remove('wait'); io.unobserve(e.target); }
  }, { threshold: 0.5 });
  for (const el of document.querySelectorAll<HTMLElement>('[data-report-progress]')) {
    el.classList.add('wait');
    io.observe(el);
    const start = Number(el.dataset.start), end = Number(el.dataset.end);
    const pct = Math.min(100, Math.max(0, Math.floor((100 * (Date.now() - start)) / (end - start))));
    el.querySelector<HTMLElement>('[data-fill]')!.style.width = `${pct}%`;
    el.querySelector('[role=progressbar]')!.setAttribute('aria-valuenow', String(pct));
  }
</script>
